{
  "name": "readnote-atlas",
  "version": "0.3.1",
  "private": true,
  "description": "A local-first reading and video study workspace for Chinese readers.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-article-reader.mjs",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run typecheck && bash scripts/check-release.sh",
    "package": "npm run build && bash scripts/package-extension.sh",
    "companion": "node scripts/companion/companion-server.mjs",
    "desktop:captions": "node scripts/desktop-captions/run.mjs",
    "prototype:desktop-captions": "node scripts/desktop-captions/run.mjs"
  },
  "dependencies": {
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.313",
    "@types/node": "^25.9.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.16"
  }
}
